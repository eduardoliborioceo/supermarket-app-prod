<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Minimal XML theme used only for the launch/splash window before Compose
      takes over via setContent { } in MainActivity. All real theming (colors,
      typography, shapes) lives in ui/theme/Theme.kt as Compose Material 3.
    -->
    <style name="Theme.Supermercado.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- Dedicated asset (extra padding) because the system splash icon
             masks anything outside its ~66% safe-zone circle; the raw
             launcher icon fills too close to the edge and gets clipped. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_supermercado_logo_splash</item>
        <!-- Text-as-image ("From" / "Droid Codes"), same brand pattern as
             Instagram's "from Meta" mark, rendered by the system splash
             itself so there is a single splash screen, not two in sequence.
             Framework attribute (API 31+, no androidx compat equivalent) —
             a safe no-op on minSdk 26-30, where only the icon splash shows. -->
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_supermercado_splash_branding</item>
        <item name="postSplashScreenTheme">@style/Theme.Supermercado</item>
    </style>

    <style name="Theme.Supermercado" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
